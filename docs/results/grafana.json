{
  "sources": [
    {
      "name": "Alertmanager",
      "uid": "alertmanager",
      "type": "alertmanager",
      "mapping": {}
    },
    {
      "name": "Loki",
      "uid": "loki",
      "type": "loki",
      "mapping": {
        "derivedFields": [
          {
            "datasourceUid": "tempo",
            "matcherRegex": "\"trace_id\": \"([0-9a-f]{32})\"",
            "name": "TraceID",
            "url": "${__value.raw}",
            "urlDisplayLabel": "Трейс"
          }
        ]
      }
    },
    {
      "name": "Prometheus",
      "uid": "prometheus",
      "type": "prometheus",
      "mapping": {
        "exemplarTraceIdDestinations": [
          {
            "datasourceUid": "tempo",
            "name": "trace_id",
            "urlDisplayLabel": "Трейс"
          }
        ]
      }
    },
    {
      "name": "Tempo",
      "uid": "tempo",
      "type": "tempo",
      "mapping": {
        "tracesToLogsV2": {
          "customQuery": true,
          "datasourceUid": "loki",
          "filterByTraceID": false,
          "query": "{namespace=\"demo\"} | json | trace_id=\"${__trace.traceId}\""
        }
      }
    }
  ],
  "dashboards": [
    {
      "uid": "mtc-red",
      "title": "Checkout RED"
    },
    {
      "uid": "mtc-slo",
      "title": "SLO checkout"
    },
    {
      "uid": "mtc-incident",
      "title": "Инцидент"
    },
    {
      "uid": "mtc-overview",
      "title": "Обзор сервисов"
    }
  ],
  "passed": true
}
